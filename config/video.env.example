# Video generation mode: local uses ComfyUI; api uses a MiniMax-compatible I2V API.
MOVIE_VIDEO_MODE=local
MOVIE_VIDEO_API_KEY=
MOVIE_VIDEO_API_BASE_URL=https://api.minimax.io
MOVIE_VIDEO_API_MODEL=MiniMax-Hailuo-02
MOVIE_VIDEO_API_DURATION=10
MOVIE_VIDEO_API_RESOLUTION=768P
MOVIE_VIDEO_API_CONFIG_PATH=
MOVIE_VIDEO_API_TIMEOUT=1800
MOVIE_VIDEO_API_POLL_INTERVAL=5
