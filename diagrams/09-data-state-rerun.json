      "sublabel": "保留原因 · 阶段 · 版本"
    },
    {
      "id": "cache_exchange",
      "lane": "display",
      "col": 5,
      "width": 132,
      "type": "external",
      "label": "刷新缓存与即时交换",
      "sublabel": "Redis · 临时 JSON · 文件路径"
    }
  ],
  "edges": [
    {
      "from": "ui_request",
      "to": "load_db",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "load_db",
      "to": "materialize_json",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "materialize_json",
      "to": "run_cli",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "run_cli",
      "to": "persist_result",
      "role": "main",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "persist_result",
      "to": "stage_list",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight"
    },
    {
      "from": "persist_result",
      "to": "cache_exchange",
      "label": "失效缓存 / 按需导出",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "from": "run_cli",
      "to": "rerun_stage",
      "label": "失败",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "rerun_stage",
      "to": "materialize_json",
      "label": "恢复当前快照",
      "role": "return",
      "variant": "security"
    }
  ],
  "mainPath": [
    "ui_request",
    "load_db",
    "materialize_json",
    "run_cli",
    "persist_result",
    "stage_list"
  ]
}
