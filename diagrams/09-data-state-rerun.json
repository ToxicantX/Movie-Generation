{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "09 · 数据状态、临时交换与重跑",
    "locale": "zh-CN",
    "output": "diagrams/09-data-state-rerun.html",
    "animation": "none",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "request",
      "label": "提交阶段任务"
    },
    {
      "id": "load",
      "label": "读取项目状态"
    },
    {
      "id": "materialize",
      "label": "物化临时 JSON"
    },
    {
      "id": "execute",
      "label": "执行流水线与重跑"
    },
    {
      "id": "persist",
      "label": "写回 PostgreSQL"
    },
    {
      "id": "display",
      "label": "列表展示与缓存交换"
    }
  ],
  "semanticChecks": {
    "allowedRoots": [
      "ui_request"
    ],
    "allowedTerminals": [
      "stage_list",
      "cache_exchange"
    ],
    "requiredPaths": [
      {
        "from": "ui_request",
        "to": "stage_list"
      },
      {
        "from": "persist_result",
        "to": "cache_exchange"
      }
    ]
  },
  "nodes": [
    {
      "id": "ui_request",
      "lane": "request",
      "col": 3,
      "type": "frontend",
      "label": "提交阶段任务",
      "sublabel": "项目 · 动作 · shot_id",
      "width": 132
    },
    {
      "id": "load_db",
      "lane": "load",
      "col": 3,
      "type": "database",
      "label": "读取项目状态",
      "sublabel": "manifest + artifacts",
      "width": 132
    },
    {
      "id": "materialize_json",
      "lane": "materialize",
      "col": 3,
      "width": 132,
      "type": "backend",
      "label": "物化临时 JSON",
      "sublabel": "仅供脚本运行"
    },
    {
      "id": "run_cli",
      "lane": "execute",
      "col": 3,
      "type": "backend",
      "label": "执行流水线 CLI",
      "sublabel": "生成 / 审核 / 重跑",
      "width": 132
    },
    {
      "id": "persist_result",
      "lane": "persist",
      "col": 3,
      "width": 132,
      "type": "database",
      "label": "写回 PostgreSQL",
      "sublabel": "项目 · 清单 · JSONB"
    },
    {
      "id": "stage_list",
      "lane": "display",
      "col": 3,
      "width": 132,
      "type": "frontend",
      "label": "数据库列表展示",
      "sublabel": "状态 · 来源 · 模型 · 数量"
    },
    {
      "id": "rerun_stage",
      "lane": "execute",
      "col": 5,
      "width": 132,
      "type": "messagebus",
